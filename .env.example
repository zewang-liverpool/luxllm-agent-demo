# Runtime selection
LUX_LLM_ENABLED=1
LUX_LLM_PLAYER=player_0
LUX_FALLBACK_PLAYER=player_1
LUX_LLM_MODEL=qwen3:32b
LUX_LLM_BASE_URL=http://127.0.0.1:11434

# Deterministic experiment settings
LUX_LLM_TEMPERATURE=0.0
LUX_LLM_SEED=42
LUX_LLM_NUM_PREDICT=120
LUX_LLM_TIMEOUT_SECONDS=30
LUX_LLM_THINK=0
LUX_LLM_JSON_MODE=1

# Feature switches
LUX_ENABLE_STRATEGY_CACHE=1
LUX_ENABLE_RISK_AWARE_ACTION_FILTER=1
LUX_ENABLE_RULE_FALLBACK=1
LUX_FORCE_RULE_ONLY=0
LUX_FORCE_FALLBACK=0

# Each run should set a separate absolute output directory.
LUX_RUN_DIR=results/manual_run
LUX_EXPERIMENT_TAG=manual_reproduction
